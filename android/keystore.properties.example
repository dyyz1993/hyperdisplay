# 复制为 android/keystore.properties 后填入真实值；此文件和 .jks 均不会进入 Git。
# 首次生成密钥可用：
# keytool -genkeypair -v -keystore ~/Hyperdisplay-release.jks -alias hyperdisplay \\
#   -keyalg RSA -keysize 4096 -validity 10000
storeFile=/absolute/path/to/Hyperdisplay-release.jks
storePassword=CHANGE_ME
keyAlias=hyperdisplay
keyPassword=CHANGE_ME
